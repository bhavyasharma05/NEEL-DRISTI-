# ==============================================================================
# Neel Drishti - Environment Configuration Template
# ==============================================================================

# Cohere API Configuration (Required for LLM query & summarization)
COHERE_API_KEY=your_cohere_api_key_here

# Google Cloud BigQuery Configuration
BQ_PROJECT_ID=floatchat-472116
BQ_DATASET_ID=argo
BQ_TABLE_NAME=argo_profiles
GOOGLE_APPLICATION_CREDENTIALS=floatchat-key.json

# Vector Store & Embedding Configuration
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
BQ_SAMPLE_LIMIT=10000
EMBEDDING_BATCH_SIZE=128

# Server & Query Configuration
ALLOW_ASK_BEFORE_READY=true
MAX_QUERY_ROWS=1000
DEFAULT_TIME_INTERVAL_DAYS=180
QA_CACHE_TTL_SECONDS=300

# Backend URL (used by Streamlit and Frontend)
BACKEND_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000
